DEFINE SCHEMA

    RECORD TYPE CD_Batch (
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_currency            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_currency_ckAsset    ASSET,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expiryDay           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expiryDay_ckAsset   ASSET,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isArchived          INT64 QUERYABLE SORTABLE,
        CD_product             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_purchaseDay         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_purchaseDay_ckAsset ASSET,
        CD_quantityPurchased   INT64 QUERYABLE SORTABLE,
        CD_schemaVersion       INT64 QUERYABLE SORTABLE,
        CD_source              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_source_ckAsset      ASSET,
        CD_totalPriceCents     INT64 QUERYABLE SORTABLE,
        CD_updatedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_useDespiteExpiry    INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE CD_Product (
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_baseUnitRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_baseUnitRaw_ckAsset  ASSET,
        CD_brand                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_brand_ckAsset        ASSET,
        CD_carbsPerPortionG     DOUBLE QUERYABLE SORTABLE,
        CD_categoryRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_categoryRaw_ckAsset  ASSET,
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_flavor               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_flavor_ckAsset       ASSET,
        CD_glucoseFructoseRatio DOUBLE QUERYABLE SORTABLE,
        CD_hasCaffeine          INT64 QUERYABLE SORTABLE,
        CD_hasLactate           INT64 QUERYABLE SORTABLE,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isArchived           INT64 QUERYABLE SORTABLE,
        CD_name                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset         ASSET,
        CD_portionAmount        DOUBLE QUERYABLE SORTABLE,
        CD_schemaVersion        INT64 QUERYABLE SORTABLE,
        CD_updatedAt            TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE CD_PurchaseEvaluation (
        "___createTime"            TIMESTAMP,
        "___createdBy"             REFERENCE,
        "___etag"                  STRING,
        "___modTime"               TIMESTAMP,
        "___modifiedBy"            REFERENCE,
        "___recordID"              REFERENCE QUERYABLE,
        CD_createdAt               TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_inputJSON               BYTES,
        CD_inputJSON_ckAsset       ASSET,
        CD_reasonsJSON             BYTES,
        CD_reasonsJSON_ckAsset     ASSET,
        CD_schemaVersion           INT64 QUERYABLE SORTABLE,
        CD_userDecisionRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_userDecisionRaw_ckAsset ASSET,
        CD_verdictQuantity         INT64 QUERYABLE SORTABLE,
        CD_verdictRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_verdictRaw_ckAsset      ASSET,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE CD_ShoppingListItem (
        "___createTime"             TIMESTAMP,
        "___createdBy"              REFERENCE,
        "___etag"                   STRING,
        "___modTime"                TIMESTAMP,
        "___modifiedBy"             REFERENCE,
        "___recordID"               REFERENCE QUERYABLE,
        CD_batchID                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_estimatedTotalPriceCents INT64 QUERYABLE SORTABLE,
        CD_expiryDay                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expiryDay_ckAsset        ASSET,
        CD_freeText                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_freeText_ckAsset         ASSET,
        CD_id                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_offerJSON                BYTES,
        CD_offerJSON_ckAsset        ASSET,
        CD_plannedQuantity          INT64 QUERYABLE SORTABLE,
        CD_productID                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_schemaVersion            INT64 QUERYABLE SORTABLE,
        CD_stateRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_stateRaw_ckAsset         ASSET,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE CD_StockMovement (
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE QUERYABLE,
        CD_batch                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_createdAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_delta                  INT64 QUERYABLE SORTABLE,
        CD_deviceID               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_deviceID_ckAsset       ASSET,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_idempotencyKey         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_idempotencyKey_ckAsset ASSET,
        CD_note                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset           ASSET,
        CD_occurredAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_referenceID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_reversesMovementID     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_schemaVersion          INT64 QUERYABLE SORTABLE,
        CD_typeRaw                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_typeRaw_ckAsset        ASSET,
        GRANT WRITE TO "_creator"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
